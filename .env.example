# Copy to .env (chmod 600 .env). Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/<account_id>/<hook_id>/
# Second hook: debtors with no purchased invoices in the activity window (no CreditSafe path)
ZAPIER_INACTIVE_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/<account_id>/<inactive_hook_id>/

# Optional overrides (defaults shown)
# STATE_DB_PATH=state/deliveries.sqlite3
# LOCK_PATH=state/job.lock
# LOG_DIR=logs
# WEBHOOK_CONNECT_TIMEOUT=5
# WEBHOOK_READ_TIMEOUT=20
# WEBHOOK_MAX_ATTEMPTS=4
# WEBHOOK_BACKOFF_BASE_SECONDS=2
# WEBHOOK_RETRY_AFTER_MAX_SECONDS=60
# MAX_CONSECUTIVE_FAILED_EVENTS=3
# ACTIVITY_WINDOW_DAYS=90
# RECONCILE_STALE_DAYS=3
# REPORT_VALIDITY_DAYS=30
